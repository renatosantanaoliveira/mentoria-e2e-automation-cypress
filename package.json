{
  "name": "mentoria-e2e-automation-cypress",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:open:dev": "CYPRESS_ENV=dev cypress open",
    "cy:open:qa": "CYPRESS_ENV=qa cypress open",
    "cy:open:prd": "CYPRESS_ENV=prd cypress open",
    "cy:run": "cypress run",
    "cy:run:dev": "CYPRESS_ENV=dev cypress run",
    "cy:run:qa": "CYPRESS_ENV=qa cypress run",
    "cy:run:prd": "CYPRESS_ENV=prd cypress run",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test": "npm run cy:run && npm run allure:report",
    "test:dev": "npm run cy:run:dev && npm run allure:report",
    "test:qa": "npm run cy:run:qa && npm run allure:report",
    "test:prd": "npm run cy:run:prd && npm run allure:report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatosantanaoliveira/mentoria-e2e-automation-cypress.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/renatosantanaoliveira/mentoria-e2e-automation-cypress/issues"
  },
  "homepage": "https://github.com/renatosantanaoliveira/mentoria-e2e-automation-cypress#readme",
  "devDependencies": {
    "allure-commandline": "^2.38.1",
    "allure-cypress": "^3.6.0",
    "cypress": "^15.13.0"
  }
}
