# =============================================================================
# Node.js
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# =============================================================================
# Cypress - Artefatos gerados em execução
# =============================================================================

# Vídeos gravados durante os testes (gerados automaticamente)
cypress/videos/

# Screenshots capturadas em falhas ou via cy.screenshot()
cypress/screenshots/

# Arquivos baixados durante testes (ex: PDFs, CSVs via cy.readFile ou download)
cypress/downloads/

# Relatórios gerados (ex: mochawesome, allure)
cypress/reports/

# Allure - resultados brutos gerados por cada execução do Cypress
allure-results/

# Allure - relatório HTML final gerado pelo allure generate
allure-report/

# =============================================================================
# Variáveis de ambiente e credenciais (NUNCA versionar)
# =============================================================================

# Arquivo principal de variáveis de ambiente locais
.env
.env.local
.env.development
.env.staging
.env.production

# Cypress env com credenciais (ex: AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET, senhas)
# Use cypress.env.json apenas localmente — nunca suba para o repositório
cypress.env.json

# =============================================================================
# IDEs e editores
# =============================================================================

# VSCode
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/

# =============================================================================
# Sistema Operacional
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Logs e temporários
# =============================================================================
*.log
*.tmp
*.cache
.nyc_output/
coverage/
